# CogMem Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to version control.

# === Primary LLM (OpenAI-compatible API) ===
# Any OpenAI-compatible endpoint works: DeepSeek, OpenAI, Qwen/DashScope, etc.
COGMEM_API_KEY=your-api-key-here
COGMEM_BASE_URL=https://api.deepseek.com/v1
COGMEM_MODEL=deepseek-chat

# === Optional: Multi-channel failover ===
# Configure additional channels for automatic failover
# CHANNEL_2_API_KEY=
# CHANNEL_2_BASE_URL=
# CHANNEL_2_MODEL=

# === Embedding Model (optional) ===
# Default: all-MiniLM-L6-v2 (384-dim, English-focused)
# For Chinese: BAAI/bge-small-zh-v1.5 (512-dim)
# COGMEM_EMBED_MODEL=all-MiniLM-L6-v2
